{
  "functions": {
    "api/try/search.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/mail-full",
      "destination": "/mail-full/index.html"
    },
    {
      "source": "/mail-full/",
      "destination": "/mail-full/index.html"
